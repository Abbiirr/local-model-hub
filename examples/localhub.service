[Unit]
Description=LocalHub Compass
After=network.target

[Service]
Type=simple
User=localhub
Group=localhub
WorkingDirectory=/var/lib/localhub
StateDirectory=localhub
ExecStart=/usr/local/bin/localhub --config /etc/localhub/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
